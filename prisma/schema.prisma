generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  subject     String
  topic       String
  grade       Int
  link        String
  createdAt   DateTime @default(now())
}
