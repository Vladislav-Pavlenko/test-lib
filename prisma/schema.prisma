generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subject {
  id    Int    @id @default(autoincrement())
  name  String
  tests Test[]
}

model Author {
  id    Int    @id @default(autoincrement())
  name  String
  tests Test[]
}

model Test {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  topic       String
  grade       Int
  link        String
  createdAt   DateTime @default(now())

  subjectId  Int
  subjectRel Subject @relation(fields: [subjectId], references: [id])

  authorId Int?
  author   Author? @relation(fields: [authorId], references: [id])
}
