generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String
  tests Test[]
}

model Test {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  subject     String
  topic       String
  grade       Int
  link        String
  createdAt   DateTime @default(now())
  genreId     Int
  genre       Genre    @relation(fields: [genreId], references: [id])
}
